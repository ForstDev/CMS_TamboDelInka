# Copia este archivo como .env para desarrollo local.
# Si DATABASE_URL y SUPABASE_URL están vacíos, el CMS funciona en modo local:
# base de datos embebida en .data/pgdata y archivos en .data/uploads.

# Cliente cuyos datos sirve esta instalación (carpeta clients/<CLIENT_ID>).
CLIENT_ID=intursa

# Secreto para firmar la sesión del CMS. En producción: una cadena larga y aleatoria (mínimo 32 caracteres).
# Sin él, en producción la app NO arranca; en desarrollo usa una clave temporal que cambia al reiniciar.
SESSION_SECRET=

# Contraseña inicial del administrador. OBLIGATORIA con Supabase (en client.json solo hay una de demostración).
# Solo se usa al crear el usuario; si ya existe no se cambia (salvo que la vuelvas a definir aquí a propósito).
ADMIN_PASSWORD=

# Cuántos proxies de confianza hay delante de la app (para leer la IP real del visitante y bloquear intentos de login).
# 1 = Vercel o un solo nginx/balanceador (por defecto). 2 = CDN + nginx. 0 = la app está expuesta directo, sin proxy.
# Un valor incorrecto deja que un atacante falsee su IP y se salte el bloqueo del login.
TRUST_PROXY=1

# Supabase › Connect › "Transaction pooler" (puerto 6543). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=

# Supabase › Project Settings › Data API (URL) y › API Keys (secret key o service_role).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 1 = pide a los buscadores no indexar el sitio (recomendado mientras sea demo).
NOINDEX=1

# Zona horaria para agrupar las estadísticas por día y hora.
STATS_TZ=America/Lima

# Puerto local.
PORT=3000
