# Copia este archivo como .env para desarrollo local.
# Si DATABASE_URL y SUPABASE_URL están vacíos, el CMS funciona en modo local:
# base de datos embebida en .data/pgdata y archivos en .data/uploads.

# Cliente cuyos datos sirve esta instalación (carpeta clients/<CLIENT_ID>).
CLIENT_ID=intursa

# Secreto para firmar la sesión del CMS. En producción: una cadena larga y aleatoria.
SESSION_SECRET=

# Supabase › Connect › "Transaction pooler" (puerto 6543). Reemplaza [YOUR-PASSWORD].
DATABASE_URL=

# Supabase › Project Settings › Data API (URL) y › API Keys (secret key o service_role).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 1 = pide a los buscadores no indexar el sitio (recomendado mientras sea demo).
NOINDEX=1

# Zona horaria para agrupar las estadísticas por día y hora.
STATS_TZ=America/Lima

# Puerto local.
PORT=3000
