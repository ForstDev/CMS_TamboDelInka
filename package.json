{
  "name": "cms-tdi",
  "version": "1.0.0",
  "private": true,
  "description": "CMS propio para páginas de enlaces con tracking de clics. Primer cliente: Tambo del Inka – Outlets.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "setup": "tsx scripts/setup.ts",
    "verificar": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "isbot": "^5.2.2",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  }
}
